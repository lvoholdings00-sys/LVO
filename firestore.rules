rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'lvo.lmarts@gmail.com';
    }

    // User profiles for universal SSO and permissions
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Permission access requests
    match /access_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // GitHub integrated cloud pages
    match /cloud_pages/{pageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
    }

    // Shared universal database entries from any connected page
    match /database_entries/{entryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
    }

    // Universal SSO activity and session verification logs
    match /sso_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // immutable audit trail
    }
  }
}
